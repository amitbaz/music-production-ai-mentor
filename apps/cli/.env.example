# Copy this file to .env and fill in the values.
GEMINI_API_KEY=
# Only needed to run on Claude (pnpm eval <case> --model claude:claude-haiku-5-5).
ANTHROPIC_API_KEY=
# Where the Remote Script in Ableton Live listens.
ABLETON_ADDRESS=ws://127.0.0.1:39031
# ABLETON_PASSWORD is written here by `pnpm pair ableton`; leave it out.
